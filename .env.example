# --- Sui ---
NEXT_PUBLIC_SUI_NETWORK=testnet

# --- Enoki wallet onboarding (optional; testnet/mainnet only) ---
# Get an API key at the Enoki dev portal; create a Google OAuth client for the app URL.
# When unset, social login is hidden and standard wallets still work.
NEXT_PUBLIC_ENOKI_API_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Server-side private key used only to request and execute sponsored
# transactions after the exact protected-transfer command graph is verified.
# A sandbox key supports testnet; production needs explicit Enoki budget,
# origin, rate-limit, monitoring, and key-rotation policy. Never expose this
# with NEXT_PUBLIC_. When absent or rejected, the customer can still approve an
# unsponsored transaction from the same reviewed plan.
ENOKI_PRIVATE_API_KEY=

# --- Convey commerce ---
# Merchant Sui address that receives real testnet payments. Empty by default:
# when unset (or not a valid Sui address) the app runs in DEMO simulation mode
# and never claims on-chain settlement. Real payment is enabled only when the
# connected wallet network is testnet AND this is a valid Sui address.
NEXT_PUBLIC_MERCHANT_ADDRESS=

# --- Convey remittance (Send abroad) ---
# Reference quote configuration. All values are integer minor units and are
# server-side (no NEXT_PUBLIC_ prefix). When an integer is unset, a safe
# labelled reference default is used. Pricing is never called live; the quote
# is a reference quote until a regulated payout provider is configured.
# MYR sen per 1 whole USDC (default 450 = 4.50 MYR/USDC).
REMITTANCE_MYR_PER_USDC=
# PHP centavos per 1 whole USDC (default 5600 = 56.00 PHP/USDC).
REMITTANCE_PHP_PER_USDC=
# Fixed fee in MYR sen (default 200 = 2.00 MYR).
REMITTANCE_FIXED_FEE_MYR=
# Fee basis points on the send amount, 0-10000 (default 150 = 1.5%).
REMITTANCE_FEE_BPS=
# Maximum send amount in MYR sen (default 100000 = 1000 MYR).
REMITTANCE_MAX_MYR=
# Minimum send amount in MYR sen (default 100 = 1 MYR).
REMITTANCE_MIN_MYR=
# Quote time-to-live in milliseconds (default 600000 = 10 minutes; min 10000,
# max 600000).
REMITTANCE_QUOTE_TTL_MS=
# Per-beneficiary recipient Sui address mapping (server-only JSON). Maps
# normalized beneficiary aliases to Sui addresses. Example:
#   {"ana":"0x...","maria":"0x...","juan":"0x..."}
# When unset or an alias is absent, the quote is viewable but not executable
# (the verify seam refuses to authorize). Real transfer is enabled only on
# testnet when a wallet is connected AND the beneficiary is mapped AND the
# quote attestation verifies.
REMITTANCE_RECIPIENTS_JSON=
# Server-only HMAC-SHA256 quote signing key. Exactly 64 lowercase hex
# characters (256 bits). When absent or malformed, quotes are viewable but not
# executable (the attestation is null and the verify seam refuses to authorize).
# NEVER expose this to the client. Generate a safe key with, for example:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
REMITTANCE_QUOTE_SIGNING_KEY_HEX=

# --- GonkaRouter inference (server-only) ---
# These keys are NEVER exposed to the client (no NEXT_PUBLIC_ prefix). The
# commerce, remittance, and Family Steward routes use them to call GonkaRouter's
# OpenAI-compatible /v1/chat/completions endpoint. Leave GONKA_ROUTER_API_KEY
# empty to fail closed with a clear "not configured" status — the app then uses
# its honest deterministic or local fallback and never claims live inference.
GONKA_ROUTER_API_KEY=
# Default: https://api.gonkarouter.io/v1
GONKA_ROUTER_BASE_URL=https://api.gonkarouter.io/v1
# Default model id shipped to GonkaRouter.
GONKA_MODEL_ID=deepseek-ai/DeepSeek-V4-Flash-0731
# Family Steward needs two distinct public provider model identifiers. Leave
# either blank to use the honest local fallback; never duplicate one model ID
# and present it as a council. Example shapes only: vendor/model-a and
# vendor/model-b. These values are not API keys.
GONKA_FAMILY_STEWARD_MODEL_A=
GONKA_FAMILY_STEWARD_MODEL_B=
# Request timeout in milliseconds (default 30000).
GONKA_REQUEST_TIMEOUT_MS=90000
# Max visible retries on timeout/429/transient 5xx. Must be 0 or 1.
GONKA_MAX_RETRIES=1

# --- Convey Protected Transfer (server-only) ---
# Public on-chain coordinates for the Protected Transfer escrow package and its
# reviewer/arbiter, plus a public reviewer display name. All three values are
# server-authored: neither endpoint accepts them from a client request. The
# default coordinates below point to the published Convey testnet package and
# public reviewer used by the reference lifecycle. A missing or blank value,
# malformed or zero address, equal
# package/reviewer addresses, or invalid reviewer name fails closed as
# "not_configured". The plan endpoint emits no execution plan, and the Created
# verifier emits no verified evidence. Replace the reviewer only with an
# address whose eligible human controller will approve terminal actions.
PROTECTED_TRANSFER_PACKAGE_ID=0xcf84c52207baff1b193bd01d7700aefb92c1232de3fdce8dd5cd0898600bbb5f
PROTECTED_TRANSFER_REVIEWER_ADDRESS=0x70acd3a61ca107ef0d9983cf01c6bba282475fe3bb1e6b34e50e1a47b0757543
PROTECTED_TRANSFER_REVIEWER_NAME=Convey reviewer
# When true, each protected agreement encrypts its private artifact with Seal,
# stores only ciphertext on Walrus testnet, and binds the locator/digests into
# the Sui transaction. Storage or encryption failure stops the agreement.
SEALED_EVIDENCE_ENABLED=
